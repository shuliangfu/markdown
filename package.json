    "./table": "./src/table.ts",
    "./list": "./src/list.ts",
    "./container": "./src/container.ts",
    "./emoji": "./src/emoji.ts",
    "./template": "./src/template.ts",
    "./utils": "./src/utils.ts",
    "./chart": "./src/chart.ts",
    "./code": "./src/code.ts",
    "./media": "./src/media.ts",
    "./components": "./src/components.ts",
    "./text": "./src/text.ts",
    "./interactive": "./src/interactive.ts",
    "./document": "./src/document.ts",
